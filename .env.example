# =============================================================================
# Movomatic — configuration
# En production (LXC) : /etc/movomatic/movomatic.env   |   En dev : ./.env
# =============================================================================

# --- Sécurité ---------------------------------------------------------------
# Clé à envoyer dans l'en-tête X-API-Key depuis le Raccourci iOS (16 caractères min).
# Générer : openssl rand -hex 32
MOVOMATIC_API_KEY=change-me-with-openssl-rand-hex-32

# --- Serveur ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Nombre de Reels traités en parallèle (les autres attendent).
MAX_CONCURRENT_JOBS=2

# --- Google Gemini ----------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.5-flash
# En dessous de ce seuil (0-1), on passe à l'analyse vidéo / on renonce.
GEMINI_MIN_CONFIDENCE=0.6
# Télécharger et analyser la vidéo si la légende ne suffit pas.
GEMINI_VIDEO_FALLBACK=true
GEMINI_TIMEOUT_SECONDS=180

# --- yt-dlp / Instagram -----------------------------------------------------
# Instagram exige souvent d'être connecté. Exportez vos cookies au format Netscape
# (extension « Get cookies.txt LOCALLY ») et placez-les dans /var/lib/movomatic/cookies.txt
# (chown movomatic:movomatic, chmod 600).
YTDLP_COOKIES_FILE=
YTDLP_MAX_FILESIZE_MB=100
YTDLP_MAX_DURATION_SECONDS=600
# Répertoire temporaire des vidéos (vide = /tmp, privé sous systemd).
TEMP_DIR=

# --- Jellyseerr -------------------------------------------------------------
JELLYSEERR_URL=http://192.168.1.20:5055
# Paramètres ➜ Général ➜ Clé API
JELLYSEERR_API_KEY=change-me
JELLYSEERR_TIMEOUT_SECONDS=20
JELLYSEERR_VERIFY_SSL=true
JELLYSEERR_REQUEST_4K=false
# Utilisateur Jellyseerr au nom duquel faire les requêtes (vide = propriétaire de la clé API).
JELLYSEERR_USER_ID=

# --- Surcharges Anime (optionnel) ---------------------------------------------
# Par défaut, Jellyseerr applique le profil/dossier « Anime » configuré dans
# Paramètres ➜ Services. Renseignez ces valeurs uniquement pour forcer un
# serveur, un profil de qualité ou un dossier racine spécifiques.
ANIME_SONARR_SERVER_ID=
ANIME_SONARR_PROFILE_ID=
ANIME_SONARR_ROOT_FOLDER=
ANIME_RADARR_SERVER_ID=
ANIME_RADARR_PROFILE_ID=
ANIME_RADARR_ROOT_FOLDER=
