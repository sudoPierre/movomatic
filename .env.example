# =============================================================================
# Movomatic — configuration
# Production (LXC): /etc/movomatic/movomatic.env   |   Development: ./.env
# =============================================================================

# --- Security ---------------------------------------------------------------
# Key the iOS Shortcut must send in the X-API-Key header (16 characters min).
# Generate one with: openssl rand -hex 32
MOVOMATIC_API_KEY=change-me-with-openssl-rand-hex-32

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Number of Reels processed in parallel (others wait in line).
MAX_CONCURRENT_JOBS=2

# --- Google Gemini ----------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.5-flash
# Below this threshold (0-1), fall back to video analysis / give up.
GEMINI_MIN_CONFIDENCE=0.6
# Download and analyse the video when the caption is not enough.
GEMINI_VIDEO_FALLBACK=true
GEMINI_TIMEOUT_SECONDS=180

# --- yt-dlp / Instagram -----------------------------------------------------
# Instagram often requires a logged-in session. Export your cookies in Netscape
# format (e.g. the "Get cookies.txt LOCALLY" extension) and put them in
# /var/lib/movomatic/cookies.txt (chown movomatic:movomatic, chmod 600).
YTDLP_COOKIES_FILE=
YTDLP_MAX_FILESIZE_MB=100
YTDLP_MAX_DURATION_SECONDS=600
# Temporary directory for videos (empty = /tmp, private under systemd).
TEMP_DIR=

# --- Jellyseerr -------------------------------------------------------------
JELLYSEERR_URL=http://192.168.1.20:5055
# Settings ➜ General ➜ API Key
JELLYSEERR_API_KEY=change-me
JELLYSEERR_TIMEOUT_SECONDS=20
JELLYSEERR_VERIFY_SSL=true
JELLYSEERR_REQUEST_4K=false
# Jellyseerr user to make requests on behalf of (empty = owner of the API key).
JELLYSEERR_USER_ID=

# --- Anime overrides (optional) ----------------------------------------------
# By default Jellyseerr already applies the "Anime" profile/folder configured in
# Settings ➜ Services. Only set these to force a specific server, quality
# profile or root folder.
ANIME_SONARR_SERVER_ID=
ANIME_SONARR_PROFILE_ID=
ANIME_SONARR_ROOT_FOLDER=
ANIME_RADARR_SERVER_ID=
ANIME_RADARR_PROFILE_ID=
ANIME_RADARR_ROOT_FOLDER=
