[Unit]
Description=Movomatic — Instagram Reel ➜ Gemini ➜ Jellyseerr
Documentation=https://github.com/sudoPierre/movomatic
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=movomatic
Group=movomatic
WorkingDirectory=/opt/movomatic
EnvironmentFile=/etc/movomatic/movomatic.env
Environment=PYTHONUNBUFFERED=1
Environment=XDG_CACHE_HOME=/var/cache/movomatic
ExecStart=/opt/movomatic/.venv/bin/movomatic
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Directories managed by systemd (created with the right ownership):
#   /var/lib/movomatic   -> Instagram cookies (cookies.txt)
#   /var/cache/movomatic -> yt-dlp cache
StateDirectory=movomatic
CacheDirectory=movomatic
PrivateTmp=true

# Hardening. If the service fails with "226/NAMESPACE" in an unprivileged LXC,
# enable the container's "nesting" feature or comment out the Protect*/Private* lines.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
